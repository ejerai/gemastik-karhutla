  const nat = data.national || {};
  const trend = nat.daily_trend || [];
  new Chart(document.getElementById('chart-national-trend'), {
    type:'line',
    data:{ labels: trend.map(t=>t.date), datasets:[{data: trend.map(t=>t.count), borderColor:EMBER_L, backgroundColor:'rgba(255,180,84,0.1)', fill:true, tension:.3, pointRadius:0, borderWidth:2}]},
    options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}, ticks:{maxTicksLimit:8}}, y:{grid:{color:'#1E2723'}}}}
  });

  const reg = (nat.regional || []).slice().sort((a,b)=>b.count-a.count);
  new Chart(document.getElementById('chart-regional'), {
    type:'bar',
    data:{ labels: reg.map(r=>r.region), datasets:[{data: reg.map(r=>r.count), backgroundColor: reg.map((_,i)=> i===0?EMBER:'rgba(255,122,51,0.35)'), borderRadius:6, maxBarThickness:34}]},
    options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, indexAxis:'y', scales:{x:{grid:{color:'#1E2723'}}, y:{grid:{display:false}}}}
  });

  const donutOpts = {responsive:true, maintainAspectRatio:false, cutout:'68%', plugins:{legend:{position:'bottom', labels:{boxWidth:9, boxHeight:9, padding:10, font:{size:10.5}}}}};
