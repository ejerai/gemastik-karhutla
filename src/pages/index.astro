<script is:inline>
/* ============================================================
   DARK / LIGHT MODE TOGGLE
   Tema awal sudah diset sesinkron mungkin lewat script kecil di <head>
   (menghindari FOUC). Blok ini menangani: tombol toggle di footer,
   penyimpanan preferensi, update meta theme-color (warna chrome browser
   di mobile), transisi warna halus, dan menyinkronkan ulang warna
   grid/text Chart.js supaya chart yang sudah kadung dirender ikut
   berubah saat tema di-switch (bukan cuma elemen HTML/CSS biasa). */
(function(){
  function getTheme(){ return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark'; }

  function updateMetaThemeColor(){
    var bg = getComputedStyle(document.documentElement).getPropertyValue('--bg').trim();
    if(!bg) return;
    document.querySelectorAll('meta[name="theme-color"], meta[name="msapplication-TileColor"]').forEach(function(m){ m.setAttribute('content', bg); });
  }

  function applyTheme(theme){
    var html = document.documentElement;
    if(theme === 'light') html.setAttribute('data-theme', 'light');
    else html.removeAttribute('data-theme');
    try{ localStorage.setItem('karhutla-theme', theme); }catch(e){}
    updateMetaThemeColor();
    if(window.applyChartTheme) window.applyChartTheme();
  }

  // Fallback lama (cross-fade halus) — dipakai kalau overlay tidak ada
  // atau pengguna minta reduced motion.
  function setThemeFade(theme){
    var html = document.documentElement;
    html.classList.add('theme-transition');
    window.setTimeout(function(){ html.classList.remove('theme-transition'); }, 400);
    applyTheme(theme);
  }

  function prefersReducedMotion(){
    try{ return window.matchMedia('(prefers-reduced-motion: reduce)').matches; }catch(e){ return false; }
  }

  /* ===== Curtain wipe dari bawah ke atas =====
     Pakai View Transitions API bawaan browser: browser "foto" tampilan
     lama & baru, lalu kita kontrol clip-path (inset) lewat Web Animations
     API supaya tema baru "naik" seperti tirai dari tepi bawah layar ke
     atas. Kalau browser belum dukung (mis. Firefox) atau reduced-motion
     aktif, turun ke cross-fade lama supaya tetap mulus. */
  var revealBusy = false;
  function playCurtainWipe(theme){
    if(!document.startViewTransition || prefersReducedMotion()){
      setThemeFade(theme);
      return;
    }
    if(revealBusy) return;
    revealBusy = true;

    var transition = document.startViewTransition(function(){ applyTheme(theme); });

    transition.ready.then(function(){
      document.documentElement.animate(
        {
          clipPath: [
            'inset(100% 0 0 0)',
            'inset(0% 0 0 0)'
          ]
        },
        {
          duration: 900,
          easing: 'cubic-bezier(.4,0,.2,1)',
          pseudoElement: '::view-transition-new(root)'
        }
      );
    });

    transition.finished.finally(function(){ revealBusy = false; });
  }

  updateMetaThemeColor();

  var btn = document.getElementById('theme-toggle');

  if(btn){
    btn.addEventListener('click', function(){
      playCurtainWipe(getTheme() === 'light' ? 'dark' : 'light');
    });
  }

  // Ikut mengganti tema kalau preferensi sistem berubah, TAPI hanya jika
  // pengguna belum pernah memilih manual lewat tombol (belum ada preferensi
  // tersimpan) — begitu user pernah klik toggle, pilihannya dihormati terus.
  try{
    var mq = window.matchMedia('(prefers-color-scheme: light)');
    mq.addEventListener('change', function(e){
      if(localStorage.getItem('karhutla-theme')) return;
      playCurtainWipe(e.matches ? 'light' : 'dark');
    });
  }catch(e){}
})();

/* ============================================================
