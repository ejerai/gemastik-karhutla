    roc_curve: { fpr: [0,0.02,0.05,0.09,0.15,0.25,0.4,0.6,1], tpr: [0,0.42,0.63,0.76,0.85,0.91,0.95,0.98,1] },
    classification_report: {
      "Tidak Terbakar": {precision:0.941, recall:0.946, "f1-score":0.943, support:3394},
