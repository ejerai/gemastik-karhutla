  new Chart(document.getElementById('chart-confidence'), {type:'doughnut', data:{labels:Object.keys(conf), datasets:[{data:Object.values(conf), backgroundColor:[SAFE,WARN,SIAGA1], borderWidth:0}]}, options:donutOpts});

  const dn = nat.daynight || {};
  new Chart(document.getElementById('chart-daynight'), {type:'doughnut', data:{labels:Object.keys(dn), datasets:[{data:Object.values(dn), backgroundColor:[EMBER_L,'#3A4A42'], borderWidth:0}]}, options:donutOpts});

  const sat = nat.satellite || {};
