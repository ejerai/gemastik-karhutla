      {feature:"lon_grid", importance:0.152},{feature:"lat_grid", importance:0.134},
      {feature:"precip_lag1", importance:0.086},{feature:"day_of_year", importance:0.069},
      {feature:"precip_lag7", importance:0.051},{feature:"precip_mm", importance:0.037},
      {feature:"month", importance:0.019},{feature:"precip_lag3", importance:0.013}
    ]
  },
  eda: {
    precip_roll7_box: { no_fire:{q1:18.4,median:41.2,q3:78.5}, fire:{q1:0.0,median:2.1,q3:9.6} },
    correlation: {
      columns:["fire_occurred","precip_mm","precip_lag1","precip_lag3","precip_lag7","precip_roll7","precip_roll14"],
      matrix:[
        [1,-0.21,-0.19,-0.17,-0.13,-0.34,-0.31],
        [-0.21,1,0.41,0.22,0.11,0.61,0.52],
        [-0.19,0.41,1,0.38,0.19,0.68,0.55],
        [-0.17,0.22,0.38,1,0.29,0.59,0.61],
        [-0.13,0.11,0.19,0.29,1,0.44,0.58],
        [-0.34,0.61,0.68,0.59,0.44,1,0.89],
        [-0.31,0.52,0.55,0.61,0.58,0.89,1]
      ]
    }
  },
  national: {
    daily_trend: Array.from({length:30}, (_,i)=>({date:`2026-07-${(i%30+1).toString().padStart(2,'0')}`, count: Math.round(200+Math.random()*900)})),
    regional: [{region:"Kalimantan",count:18420},{region:"Sumatra",count:14210},{region:"Papua",count:6800},{region:"Sulawesi",count:4120},{region:"Jawa",count:2140},{region:"Lainnya",count:2523}],
    confidence: {nominal: 31200, low: 9800, high: 7213},
    daynight: {day: 33400, night: 14813},
    satellite: {"N20":21400,"N":18900,"N21":7913}
  },
  ews: {
    target_date: "2026-08-08",
    region_name: "Indonesia",
    mean_risk: 0.18,
    status_summary: {"Aman":78107, "Waspada":61, "SIAGA 2 (Bahaya)":20, "SIAGA 1 (Sangat Bahaya)":12},
    region_summary: {},
    top_hazard: [
      {lat:-1.2,lon:112.4,region:"Kalimantan",precip_mm:0,precip_roll7:1.2,risk_score:0.94,status:"SIAGA 1 (Sangat Bahaya)"},
      {lat:-0.8,lon:113.1,region:"Kalimantan",precip_mm:0,precip_roll7:0.4,risk_score:0.91,status:"SIAGA 1 (Sangat Bahaya)"},
      {lat:0.3,lon:101.9,region:"Sumatra",precip_mm:0.5,precip_roll7:2.8,risk_score:0.88,status:"SIAGA 1 (Sangat Bahaya)"}
    ],
    map_points: (function(){
      const pts = [];
      const clusters = [{lat:-1.4, lon:111.6, region:"Kalimantan"}, {lat:0.5, lon:102.0, region:"Sumatra"}];
      for(let lat=-8; lat<=5; lat+=0.4){
        for(let lon=96; lon<=139; lon+=0.4){
          let best = 0;
          clusters.forEach(c=>{
            const dist = Math.sqrt((lat-c.lat)**2 + ((lon-c.lon)*0.85)**2);
            best = Math.max(best, Math.max(0, 0.95 - dist*0.42));
          });
          const risk = Math.max(0.01, Math.min(0.98, best + (Math.random()*0.05-0.025)));
          if(risk < 0.2 && Math.random() > 0.06) continue;
          const status = risk>=0.75?"SIAGA 1 (Sangat Bahaya)":risk>=0.5?"SIAGA 2 (Bahaya)":risk>=0.25?"Waspada":"Aman";
          const precip = Math.max(0, 25 - risk*24 + (Math.random()*6-3));
          pts.push({lat:+lat.toFixed(2), lon:+lon.toFixed(2), risk_score:+risk.toFixed(2), precip_mm:+precip.toFixed(1), status, region:"Lainnya"});
        }
      }
      return pts;
    })(),
    projection: [0,1,2,3,4,5,6,7].map(i=>({date:`0${8+i>9?'':'0'}${8+i} Agt`.slice(-6), mean_risk: +(0.15+i*0.02+Math.random()*0.03).toFixed(2), siaga1_count: Math.round(10+i*3+Math.random()*4)}))
  },
